<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SyncLabsHub.App</RootNamespace>
    <AssemblyName>SyncLabsHub</AssemblyName>
    <AssemblyTitle>SyncLabs Hub</AssemblyTitle>
    <Version>1.0.0</Version>
    <Description>Central launcher and license manager for SyncLabs AEC tools.</Description>
    <ApplicationIcon>SyncLabsHub.ico</ApplicationIcon>
    <StartupObject>SyncLabsHub.App.App</StartupObject>
  </PropertyGroup>

  <!-- App.xaml as a Page (not ApplicationDefinition) so our explicit Main() is the entry point. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncLabsHub.Core\SyncLabsHub.Core.csproj" />
  </ItemGroup>

</Project>
