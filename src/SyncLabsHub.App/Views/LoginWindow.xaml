<ui:FluentWindow
    x:Class="SyncLabsHub.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SyncLabsHub.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SyncLabs Hub"
    Width="440" Height="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SyncLabs Hub" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="44,0">
            <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <ui:SymbolIcon Symbol="AppFolder24" FontSize="28"/>
            </Border>

            <TextBlock Text="SyncLabs Hub" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,2"/>
            <TextBlock Text="Sign in to access your tools" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="Email" Opacity="0.8" Margin="0,0,0,5"/>
            <ui:TextBox x:Name="EmailInput"
                        PlaceholderText="you@company.com"
                        Icon="{ui:SymbolIcon Mail24}"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,16"/>

            <TextBlock Text="Password" Opacity="0.8" Margin="0,0,0,5"/>
            <ui:PasswordBox x:Name="PasswordInput"
                            PlaceholderText="Enter your password"
                            Icon="{ui:SymbolIcon LockClosed24}"
                            KeyDown="OnPasswordKeyDown"
                            Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Error}" Foreground="#F87171"
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Visibility="{Binding Error, Converter={StaticResource StrToVisibility}}"/>

            <ui:Button Content="Sign In" Appearance="Primary"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Click="OnSignInClick"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>

            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,16,0,0"
                             HorizontalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,22,0,0"
                       Opacity="0.5" FontSize="11"
                       Text="Need an account? Visit synclabs.io"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
