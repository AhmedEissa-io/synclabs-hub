<ui:FluentWindow
    x:Class="SyncLabsHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SyncLabsHub.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SyncLabs Hub"
    Width="1080" Height="720"
    MinWidth="860" MinHeight="560"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowState="Maximized">

    <ui:FluentWindow.Resources>

        <!-- ═══ Tool card ═══ -->
        <DataTemplate DataType="{x:Type vm:ToolTileViewModel}">
            <ui:Card Width="252" Height="216" Margin="0,0,12,12" Opacity="{Binding TileOpacity}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" HorizontalAlignment="Left"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="{Binding Glyph, Converter={StaticResource StrToSymbol}}" FontSize="19"/>
                        </Border>
                        <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Top"
                                 Fill="{Binding StatusBrush}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Tagline}" Opacity="0.6" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                   MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                        <Border Padding="7,2" CornerRadius="4" Margin="0,0,6,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10" Opacity="0.75"/>
                        </Border>
                        <Border Padding="7,2" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.75"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="{Binding PriceText}" FontSize="11" Opacity="0.6"
                                   Margin="0,0,0,6" HorizontalAlignment="Center"
                                   Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVis}}"/>
                        <ui:Button Content="{Binding PrimaryButtonText}"
                                   Appearance="{Binding PrimaryAppearance}"
                                   Command="{Binding PrimaryCommand}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>

        <!-- ═══ My Tools ═══ -->
        <DataTemplate DataType="{x:Type vm:MyToolsViewModel}">
            <Grid Margin="24,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="My Tools" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Width="240" VerticalAlignment="Bottom"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Search tools…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="LICENSED" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" Margin="2,0,0,12"
                                   Visibility="{Binding HasLicensed, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Licensed}" Margin="0,0,0,18"
                                      Visibility="{Binding HasLicensed, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="AVAILABLE TO UNLOCK" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" Margin="2,0,0,12"
                                   Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Available}"
                                      Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="SearchInfo24" FontSize="36" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="No tools match your search." Margin="0,10,0,0" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══ Store ═══ -->
        <DataTemplate DataType="{x:Type vm:StoreViewModel}">
            <Grid Margin="24,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Store" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Width="240" VerticalAlignment="Bottom"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Search tools…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="SearchInfo24" FontSize="36" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="No tools match your search." Margin="0,10,0,0" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══ My Licenses ═══ -->
        <DataTemplate DataType="{x:Type vm:LicensesViewModel}">
            <Grid Margin="24,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="My Licenses" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Opacity="0.6" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasLicenses, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LicenseRowViewModel}">
                                <ui:Card Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2" Margin="0,0,14,0"
                                                Background="{Binding AccentBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding LicenseType}" Opacity="0.6" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Status" Opacity="0.5" FontSize="10"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="Expires" Opacity="0.5" FontSize="10"/>
                                            <TextBlock Text="{Binding ExpiryText}" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="4" VerticalAlignment="Center" Padding="10,5" CornerRadius="6"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding RemainingText}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasLicenses, Converter={StaticResource InvBoolToVis}}">
                    <ui:SymbolIcon Symbol="Receipt24" FontSize="40" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="No licenses yet" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Text="Browse the Store to unlock your first tool." Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══ Updates ═══ -->
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <Grid Margin="24,12,16,12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="#4ADE80"/>
                    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding Detail}" Opacity="0.6" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══ Settings ═══ -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <Grid Margin="24,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Your account and session" Opacity="0.6" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:Card Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Email" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Role" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoleText}"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Connection" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionText}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Data folder" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DataFolder}" TextWrapping="Wrap" Opacity="0.8"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Button Content="Sign Out" Appearance="Caution"
                                   Command="{Binding DataContext.LogoutCommand,
                                             RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="SignOut24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- ═══ Admin — User Management ═══ -->
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <Grid Margin="24,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Users" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding RefreshCommand}"
                               ToolTip="Refresh users" Padding="10,4" VerticalAlignment="Bottom" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="ArrowSync24"/>
                    </ui:Button>
                    <ui:TextBox Grid.Column="2" Width="220" VerticalAlignment="Bottom"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Search users…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Error InfoBar -->
                <ui:InfoBar Grid.Row="1" Severity="Error" IsClosable="False" IsOpen="True"
                            Title="Error"
                            Message="{Binding ErrorMessage}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StrToVisibility}}"
                            Margin="0,0,0,12"/>

                <!-- Loading spinner -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36"/>
                    <TextBlock Text="Loading users…" Margin="0,12,0,0" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Empty state (after load, nothing returned — likely missing RLS) -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="People24" FontSize="42" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="No users found" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Opacity="0.6" FontSize="12">
                        Add admin-level SELECT policies to <Bold>profiles</Bold>,
                        <Bold>user_roles</Bold>, and <Bold>subscription_orders</Bold>
                        in your Supabase dashboard.
                    </TextBlock>
                </StackPanel>

                <!-- Users list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8">
                                    <StackPanel>

                                        <!-- ── User header row ── -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar circle with initials -->
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="{DynamicResource SystemAccentColorBrush}"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserInitials}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>

                                            <!-- Display name + email -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Email}" Opacity="0.5"
                                                           FontSize="11" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Role badge -->
                                            <Border Grid.Column="2" Margin="12,0,12,0" Padding="8,3"
                                                    CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding RoleText}" FontSize="11" Opacity="0.75"/>
                                            </Border>

                                            <!-- Active tool count -->
                                            <TextBlock Grid.Column="3" Margin="0,0,14,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ToolSummary}"
                                                       FontSize="12" Opacity="0.6"/>

                                            <!-- Expand / collapse chevron -->
                                            <ui:Button Grid.Column="4" Appearance="Transparent"
                                                       Command="{Binding ToggleExpandedCommand}"
                                                       Padding="8,4">
                                                <Grid Width="18" Height="18">
                                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14"
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource InvBoolToVis}}"/>
                                                    <ui:SymbolIcon Symbol="ChevronUp24"   FontSize="14"
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </ui:Button>
                                        </Grid>

                                        <!-- ── Tool rows (visible when expanded) ── -->
                                        <Border Margin="50,14,0,2"
                                                BorderThickness="0,1,0,0"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="76"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Status dot: green = active, grey = inactive -->
                                                            <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                                                     VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#4B5563"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Fill" Value="#4ADE80"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>

                                                            <!-- Tool name -->
                                                            <TextBlock Grid.Column="1" Text="{Binding ToolName}"
                                                                       VerticalAlignment="Center" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <!-- Status text -->
                                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                                       Opacity="0.55" VerticalAlignment="Center"
                                                                       FontSize="12"/>

                                                            <!-- Expiry DatePicker — visible only for Grant / Unlock actions -->
                                                            <DatePicker Grid.Column="3"
                                                                        SelectedDate="{Binding SelectedExpiry, Mode=TwoWay}"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Margin="0,0,8,0"
                                                                        Visibility="{Binding ShowExpiryPicker, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Expiry date (leave blank for perpetual access)"/>

                                                            <!-- Lock / Unlock / Grant button -->
                                                            <ui:Button Grid.Column="4"
                                                                       Content="{Binding ActionText}"
                                                                       Appearance="{Binding ActionAppearance}"
                                                                       Command="{Binding ToggleCommand}"
                                                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                                                       Padding="8,3" FontSize="12"
                                                                       HorizontalAlignment="Stretch"
                                                                       HorizontalContentAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- ═══ Sidebar item ═══ -->
        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding NavGlyph, Converter={StaticResource StrToSymbol}}"
                               FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Title="SyncLabs Hub" Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="44,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="AppFolder24" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="SyncLabs" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text=" Hub" Opacity="0.85" FontSize="14"/>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Command="{Binding CheckForUpdatesCommand}"
                               ToolTip="Check for updates" Padding="10,4">
                        <ui:SymbolIcon Symbol="ArrowDownload24"/>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Command="{Binding RefreshCommand}"
                               ToolTip="Refresh licenses" Padding="10,4">
                        <ui:SymbolIcon Symbol="ArrowSync24"/>
                    </ui:Button>
                    <ui:Button x:Name="ThemeToggle" Appearance="Transparent"
                               Click="OnThemeToggleClick" ToolTip="Toggle theme" Padding="10,4">
                        <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherSunny24"/>
                    </ui:Button>
                    <Border Margin="6,0,12,0" Padding="10,4" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center" ToolTip="{Binding UserBadgeTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Person24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="3"
                                    Background="{DynamicResource SystemAccentColorBrush}">
                                <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             Padding="8,12,8,6" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="8,8,8,12">
                        <Border BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,8"/>
                        <ui:Button Appearance="Transparent" Command="{Binding OpenSettingsCommand}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding SelectedSection}"/>

                <ui:InfoBar Severity="Informational" IsClosable="False"
                            VerticalAlignment="Top" Margin="16"
                            Title="Update ready"
                            IsOpen="True"
                            Visibility="{Binding AvailableUpdate, Converter={StaticResource StrToVisibility}}"
                            Message="{Binding AvailableUpdate, StringFormat='SyncLabs Hub v{0} is available. Restart to update.'}">
                    <ui:Button Content="Restart to update" Appearance="Primary"
                               Command="{Binding ApplyUpdateCommand}"
                               HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </ui:InfoBar>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,5" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                <TextBlock Grid.Column="1" Text="{Binding ConnectivityText, StringFormat='Status: {0}'}"
                           VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Opacity="0.6"/>
                <TextBlock Grid.Column="2" Text="{Binding ShellVersion, StringFormat='Hub v{0}'}"
                           VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
